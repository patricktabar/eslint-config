{
  "name": "@patricktabar/eslint-config-react",
  "author": "Patrick Tabarelli <patrick.tabarelli@gmail.com>",
  "license": "MIT",
  "version": "2.0.0",
  "private": false,
  "description": "Shareable React ESLint flat config",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "rules",
    "types",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/patricktabar/eslint-config",
  "bugs": {
    "url": "https://github.com/patricktabar/eslint-config/issues",
    "email": "patrick.tabarelli@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patricktabar/eslint-config.git",
    "directory": "packages/eslint-config-react"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "config",
    "configuration",
    "react",
    "jsx",
    "a11y"
  ],
  "scripts": {
    "test": "echo 'test eslint-config-react'"
  },
  "devDependencies": {
    "@patricktabar/prettier-config": "^1.3.6",
    "prettier": "^3.8.1",
    "turbo": "^2.8.20"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@patricktabar/eslint-config-base": "workspace:^",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1"
  }
}
