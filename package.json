{
  "name": "@patricktabar/eslint-config-source",
  "author": "Patrick Tabarelli <patrick.tabarelli@gmail.com>",
  "license": "MIT",
  "version": "2.0.0",
  "private": true,
  "description": "Monorepo for shareable ESLint flat config packages",
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://github.com/patricktabar/eslint-config",
  "bugs": {
    "url": "https://github.com/patricktabar/eslint-config/issues",
    "email": "patrick.tabarelli@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patricktabar/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "monorepo",
    "config",
    "configuration"
  ],
  "scripts": {
    "build": "echo build",
    "dev": "echo dev",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "change": "npx changeset",
    "version": "npx changeset version",
    "release": "npx changeset publish"
  },
  "devDependencies": {
    "@patricktabar/prettier-config": "^1.3.6",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.20"
  },
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@changesets/cli": "^2.30.0"
  }
}
